{
  "name": "@tripcod/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":      "wrangler dev --port 4000",
    "build":    "tsc --noEmit",
    "deploy":   "wrangler deploy",
    "preview":  "wrangler dev --port 4000 --env staging",
    "typecheck": "tsc --noEmit",
    "d1:migrate":        "wrangler d1 migrations apply tripcod --remote",
    "d1:migrate:local":  "wrangler d1 migrations apply tripcod --local",
    "d1:seed:airports":  "wrangler d1 execute tripcod --remote --file d1/seed/airports.sql",
    "d1:seed:airports:local": "wrangler d1 execute tripcod --local --file d1/seed/airports.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "^3.23.0",
    "@tripcod/db": "workspace:*",
    "@tripcod/suppliers": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "@neondatabase/serverless": "^0.10.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.86.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^5.20260820.1"
  }
}
