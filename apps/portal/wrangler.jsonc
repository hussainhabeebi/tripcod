{
  "name": "tripcod-portal",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "routes": [
    { "pattern": "portal.tripcod.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
