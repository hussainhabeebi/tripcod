{
  "name": "tripcod",
  "private": true,
  "version": "0.1.0",
  "description": "Tripcod Travel Solutions — Multi-tenant white-label B2B/B2C travel portal",
  "scripts": {
    "build":          "turbo run build",
    "dev":            "turbo run dev",
    "lint":           "turbo run lint",
    "typecheck":      "turbo run typecheck",
    "test":           "turbo run test",
    "db:generate":    "pnpm --filter @tripcod/db drizzle-kit generate",
    "db:migrate":     "pnpm --filter @tripcod/db drizzle-kit migrate",
    "db:push":        "pnpm --filter @tripcod/db drizzle-kit push",
    "db:seed":        "pnpm --filter @tripcod/db tsx src/seed.ts",
    "db:studio":      "pnpm --filter @tripcod/db drizzle-kit studio",
    "deploy:api":     "pnpm --filter @tripcod/api deploy",
    "deploy:web":     "pnpm --filter @tripcod/web deploy",
    "deploy:portal":  "pnpm --filter @tripcod/portal deploy",
    "deploy:admin":   "pnpm --filter @tripcod/admin deploy",
    "clean":          "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "eslint": "^9.12.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
