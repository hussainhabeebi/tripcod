# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tripcod"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-random-64-char-secret"
COOKIE_SECRET="change-me-to-another-random-secret"

# Suppliers
RIYA_API_BASE_URL="https://api.riya.in/v2"
RIYA_API_KEY=""
RIYA_API_SECRET=""

TRIPJACK_API_BASE_URL="https://proxy.tripcod.com"
TRIPJACK_API_KEY=""
TRIPJACK_PROXY_KEY=""

DUFFEL_API_KEY=""

SERP_API_KEY=""
SERP_API_BASE_URL="https://serpapi.com"

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

NOMOD_API_KEY=""
NOMOD_API_SECRET=""
NOMOD_WEBHOOK_SECRET=""

# PhonePe PG v2 — UAT for every non-production Worker; Production only when the
# Worker is production AND PHONEPE_ENV=PRODUCTION (see docs/payments.md)
PHONEPE_ENV="UAT"
PHONEPE_UAT_CLIENT_ID=""
PHONEPE_UAT_CLIENT_SECRET=""
PHONEPE_UAT_CLIENT_VERSION=""
PHONEPE_UAT_WEBHOOK_USERNAME=""
PHONEPE_UAT_WEBHOOK_PASSWORD=""
PHONEPE_PROD_CLIENT_ID=""
PHONEPE_PROD_CLIENT_SECRET=""
PHONEPE_PROD_CLIENT_VERSION=""
PHONEPE_PROD_WEBHOOK_USERNAME=""
PHONEPE_PROD_WEBHOOK_PASSWORD=""
PUBLIC_WEB_URL="https://tripcod.com"   # customer site used in payment return URLs

# Notifications
RESEND_API_KEY=""                    # Transactional email via Resend
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Storage (for KYC docs, e-tickets, etc.)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Frontend URLs (production)
# NEXT_PUBLIC_API_URL="https://api.tripcod.com"
# NEXT_PUBLIC_WEB_URL="https://tripcod.com"
# NEXT_PUBLIC_PORTAL_URL="https://portal.tripcod.com"
# NEXT_PUBLIC_ADMIN_URL="https://admin.tripcod.com"

# Frontend URLs (local dev)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Platform defaults (used for the default Tripcod Travel Solutions tenant)
PLATFORM_TENANT_SLUG="tripcod"
PLATFORM_ADMIN_EMAIL="admin@tripcod.com"

